    private string GetAvatarColor(Guid participantId)
    {
        var colors = new[] 
        { 
            "bg-red-500", "bg-orange-500", "bg-amber-500", 
            "bg-emerald-500", "bg-teal-500", "bg-cyan-500", 
            "bg-indigo-500", "bg-violet-500", "bg-fuchsia-500", 
            "bg-pink-500", "bg-rose-500", "bg-slate-500"
        };
        
        // Use index to ensure uniqueness (up to palette size)
        var index = table?.Participants.FindIndex(p => p.Id == participantId) ?? 0;
        if (index == -1) index = 0;
        
        return colors[index % colors.Length];
    }

    // Seating Logic 
    private string GetSeatingPosition(int index, int totalCount)
    {
         if (totalCount == 0) return "";
         
         // Distribute around the ellipse
         // Formula for ellipse: x = a * cos(t), y = b * sin(t)
         // We offset by -90deg (or -PI/2) to start from top
         
         // Use percentage-based positioning relative to the container center
         // Center is 50%, 50%
         // Width radius (rw) approx 50% (to edge), Height radius (rh) approx 50%
         
         // We want them slightly OUTSIDE the table. Table is smaller than the container.
         // Table container is flex-1 p-12.
         
         double angleStep = 2 * Math.PI / totalCount;
         double startAngle = -Math.PI / 2; // Top
         
         double currentAngle = startAngle + (index * angleStep);
         
         // Radius in % relative to the section container. 
         // Table is max-w-4xl. Let's assume the container is enough.
         // We can use calc() in CSS.
         // Let's rely on trignometry to place them on a circle/ellipse trajectory.
         
         // Adjust x and y. 
         // x: 50% + (radiusX * cos(theta))
         // y: 50% + (radiusY * sin(theta))
         
         // We need to push them out enough.
         // Table aspect ratio is 2:1. Using same percentage for X and Y creates an ellipse that matches the table shape.
         // 50% puts the center of the player ON the edge.
         double rX = 52; // slightly outside
         double rY = 52; 
                         
         double x = 50 + (rX * Math.Cos(currentAngle));
         double y = 50 + (rY * Math.Sin(currentAngle));
         
         return $"left: {x.ToString(System.Globalization.CultureInfo.InvariantCulture)}%; top: {y.ToString(System.Globalization.CultureInfo.InvariantCulture)}%; transform: translate(-50%, -50%);";
    }

