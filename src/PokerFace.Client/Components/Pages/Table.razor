    // Rename Modal Logic
    private bool showRenameModal;
    private string renameValue = "";

    private void OpenRenameModal()
    {
        renameValue = me?.DisplayName ?? "";
        showRenameModal = true;
    }

    private void CloseRenameModal()
    {
        showRenameModal = false;
    }

    private async Task SubmitRename()
    {
        if (string.IsNullOrWhiteSpace(renameValue)) return;
        
        try 
        {
            await PokerService.UpdateParticipant(TableId, renameValue);
            showRenameModal = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Rename failed: {ex.Message}");
        }
    }
