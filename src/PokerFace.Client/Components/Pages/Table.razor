@page "/table/{TableId:guid}"
@using PokerFace.Client.Components.Layout
@layout TableLayout
@inject PokerService PokerService
@inject PokerRealTimeService RealTime
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Daze | @(table?.TableName ?? "Table")</PageTitle>

@if (needsToJoin)
{
    @* Join Screen - Kept simple but styled with Tailwind *@
    <div class="flex items-center justify-center min-h-screen bg-gray-50 p-4">
        <div class="w-full max-w-md bg-white rounded-xl shadow-lg p-8 border border-gray-100">
            <div class="text-center mb-8">
                 <img src="images/logo.png" alt="Daze Logo" class="h-8 mx-auto mb-4" />
                <h3 class="text-2xl font-bold text-gray-900">Join Table</h3>
                <p class="text-gray-500 mt-2">You need to join this table to participate.</p>
            </div>
            
            <EditForm Model="@joinModel" OnValidSubmit="HandleJoin" class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Display Name</label>
                    <InputText @bind-Value="joinModel.DisplayName" class="w-full rounded-lg border-gray-300 focus:border-primary focus:ring-primary shadow-sm" placeholder="Your Name" required />
                </div>
                
                <div class="flex items-center">
                    <InputCheckbox @bind-Value="joinModel.IsObserver" id="joinObserver" class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded" />
                    <label for="joinObserver" class="ml-2 block text-sm text-gray-900">Join as Observer</label>
                </div>
                
                <button type="submit" disabled="@isBusy" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-primary hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors disabled:opacity-50">
                     @if (isBusy) { <span>Joining...</span> } else { <span>Join Now</span> }
                </button>
            </EditForm>
             @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mt-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm">
                    @errorMessage
                </div>
            }
        </div>
    </div>
}
else if (isLoading)
{
     <div class="flex items-center justify-center min-h-screen bg-gray-50">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
    </div>
}
else if (table == null)
{
    <div class="flex flex-col items-center justify-center min-h-screen bg-gray-50 p-4">
        <h3 class="text-2xl font-bold text-red-600 mb-2">Failed to load table</h3>
        <p class="text-gray-500 mb-6">The table might not exist or the server is unavailable.</p>
        <button class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 transition-colors" @onclick='() => Navigation.NavigateTo("/")'>Go Home</button>
    </div>
}
else
{
    <!-- BEGIN: MainHeader -->
    <header class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between z-10 shadow-sm relative">
        <div class="flex items-center space-x-6">
            <div class="flex items-center cursor-pointer" @onclick='() => Navigation.NavigateTo("/")'>
                 <img src="images/logo.png" alt="Daze Logo" class="h-8 md:h-8" />
            </div>
            <div class="h-6 w-px bg-gray-200 hidden md:block"></div>
            <div class="flex flex-col">
                <h1 class="text-lg font-bold text-gray-900 leading-tight">@table.TableName</h1>
                <div class="flex items-center gap-2">
                    <button class="text-xs font-medium text-primary hover:underline flex items-center" @onclick="CopyLink">
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        Copy Room Link
                    </button>
                    @if (linkCopied)
                    {
                        <span class="text-xs text-green-600 font-bold fade-out">Copied!</span>
                    }
                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-3">
             @if (isModerator)
            {
                @if (session?.IsActive == false || session == null)
                {
                    <button class="px-4 py-2 text-sm font-semibold text-primary bg-white border border-primary rounded-custom hover:bg-blue-50 shadow-sm transition-all flex items-center gap-2" @onclick="StartNewSession">
                        <span class="hidden sm:inline">New Round</span>
                    </button>
                }

                @if (session?.IsActive == true)
                {
                     <button class="px-6 py-2 text-sm font-bold text-white bg-primary rounded-custom hover:opacity-90 shadow-md transition-all flex items-center gap-2" @onclick="EndSession">
                        <span>Reveal Cards</span>
                    </button>
                }
            }
             <div class="ml-4 flex items-center gap-2">
                 <span class="hidden md:inline text-sm font-medium text-gray-600">@me?.DisplayName</span>
                 <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm border border-primary/20">
                     @(me?.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                 </div>
             </div>
        </div>
    </header>
    <!-- END: MainHeader -->

    <!-- BEGIN: GameRoomArea -->
    <main class="flex-1 flex overflow-hidden relative">
        
        @if (isCountingDown)
        {
            <div class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-slate-900/80 backdrop-blur-sm text-white">
                 <h1 class="text-9xl font-black mb-4 animate-bounce">@countdownValue</h1>
                 <h2 class="text-3xl font-medium text-white/80">@countdownLabel</h2>
            </div>
        }

        <!-- BEGIN: TableView -->
        <section class="flex-1 relative flex flex-col items-center justify-center p-4 md:p-12 bg-slate-50 overflow-hidden">
            
            <!-- Central Gaming Table -->
            <div class="relative w-full max-w-4xl aspect-[2/1] poker-table-gradient rounded-[100px] md:rounded-[200px] shadow-2xl flex items-center justify-center border-gray-200">
                
                <!-- Center Content Overlay -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                     <div class="flex flex-col items-center justify-center text-center p-4 z-10">
                        @if (session?.IsActive == true)
                        {
                            <div class="opacity-10 mb-4">
                                <img src="images/logo.png" alt="Daze Watermark" class="w-32 md:w-48 grayscale" />
                            </div>
                            <h2 class="text-xl md:text-2xl font-bold text-gray-800">@session.Topic</h2>
                            <p class="text-primary font-medium animate-pulse mt-2">Voting in progress...</p>
                        }
                        else if (session?.IsActive == false && session.EndedAt.HasValue)
                        {
                             <div class="text-center">
                                <p class="text-gray-500 uppercase tracking-widest text-xs font-bold mb-1">Average</p>
                                <div class="text-5xl md:text-6xl font-black text-gray-900 mb-4">@GetAverageVote()</div>
                                <h3 class="text-lg font-bold text-gray-700 truncate max-w-md">@session.Topic</h3>
                             </div>
                        }
                        else
                        {
                            <div class="opacity-10 mb-4">
                                <img src="images/logo.png" alt="Daze Watermark" class="w-32 md:w-48 grayscale" />
                            </div>
                            <p class="text-gray-400 font-medium">Waiting for round to start...</p>
                            @if (isModerator)
                            {
                                <div class="mt-4 pointer-events-auto flex gap-2">
                                     @*<input type="text" class="px-3 py-2 rounded-lg border border-gray-300 text-sm w-48 shadow-sm focus:ring-primary focus:border-primary" placeholder="Topic (optional)" @bind="newTopic" />*@
                                     <button class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-bold hover:bg-blue-700 shadow-md transition-all" @onclick="StartSession">Start</button>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Players around the table -->
                <!-- Dynamic Positioning Logic -->
                @foreach (var (participant, index) in table.Participants.Where(p => !p.IsObserver).Select((p, i) => (p, i)))
                {
                   var position = GetSeatingPosition(index, table.Participants.Count(p => !p.IsObserver));
                   var isMe = participant.Id == me?.Id;
                   var hasVoted = participant.HasVoted;
                   var isRevealed = session?.IsActive == false && session.EndedAt.HasValue;
                   var voteValue = session?.Votes.FirstOrDefault(v => v.ParticipantId == participant.Id)?.Value;

                   <div class="absolute flex flex-col items-center transition-all duration-500 ease-out" style="@position">
                        
                        <!-- Avatar -->
                        <div class="relative">
                            <div class="w-12 h-12 md:w-14 md:h-14 rounded-full border-4 border-white shadow-lg flex items-center justify-center mb-2 overflow-hidden @($"{GetAvatarColor(participant.Id)} text-white") transition-colors duration-300">
                                <div class="w-full h-full flex items-center justify-center font-bold text-lg md:text-xl">
                                    @(participant.DisplayName?.FirstOrDefault().ToString().ToUpper())
                                </div>
                            </div>
                            @if (isMe) { <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 bg-yellow-400 text-[10px] font-bold px-1.5 rounded-full text-yellow-900 border border-white">YOU</div> }
                        </div>
                        
                        <!-- Name Badge -->
                        <span class="text-xs font-bold bg-white px-2 py-0.5 rounded shadow text-gray-700 truncate max-w-[80px]">@participant.DisplayName</span>

                        <!-- Card (if voted or revealed) -->
                        @if (isRevealed && voteValue != null)
                        {
                             <div class="mt-2 text-center transform @GetCardRotation(index)">
                                 <div class="w-10 h-14 md:w-12 md:h-16 bg-white border-2 border-primary rounded-md shadow-md flex items-center justify-center text-xl font-bold text-primary">
                                     @voteValue
                                 </div>
                             </div>
                        }
                        else if (hasVoted)
                        {
                             <div class="mt-2 w-10 h-14 md:w-12 md:h-16 card-back-pattern rounded-md shadow-md animate-bounce"></div>
                        }
                        else if (session?.IsActive == true)
                        {
                             <!-- Thinking / Empty Slot - Made visible as requested -->
                             <div class="mt-2 w-10 h-14 md:w-12 md:h-16 border-2 border-dashed border-gray-400 rounded-md bg-white/80 shadow-sm transition-all duration-300"></div>
                        }
                   </div>
                }

            </div>
            
            <!-- Mobile Votes Grid (Vertical list for small screens if table view is too cramped? keeping simple for now) -->

        </section>
        <!-- END: TableView -->

        <!-- BEGIN: RightPanel (Issues/Participants) -->
        <aside class="hidden lg:flex w-80 bg-white border-l border-gray-200 flex-col z-20 shadow-xl">
            <div class="p-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="font-bold text-gray-900">Participants (@table.Participants.Count)</h3>
                 <span class="text-xs font-medium text-gray-500">
                     @table.Participants.Count(p => p.IsConnected) Online
                 </span>
            </div>
            
            <div class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-2">
                 @foreach (var p in table.Participants.OrderByDescending(p => p.IsConnected).ThenBy(p => p.DisplayName))
                {
                    <div class="p-3 bg-white border-b border-gray-50 flex items-center justify-between hover:bg-gray-50 transition-colors rounded-lg @(p.IsConnected ? "" : "opacity-60")">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs @(p.IsConnected ? $"{GetAvatarColor(p.Id)} text-white" : "bg-gray-200 text-gray-500")">
                                @(p.DisplayName?.FirstOrDefault().ToString().ToUpper())
                            </div>
                            <div class="flex flex-col">
                                <span class="text-sm font-medium text-gray-900 flex items-center gap-1">
                                    @p.DisplayName 
                                    @if(p.Id == me?.Id) 
                                    { 
                                        <span class="text-gray-400 text-xs">(You)</span>
                                        <button class="text-gray-400 hover:text-primary ml-1" @onclick="OpenRenameModal">
                                            <span class="material-symbols-outlined text-[16px]">edit</span>
                                        </button>
                                    }
                                </span>
                                @if (p.IsModerator)
                                {
                                    <span class="text-[10px] font-bold text-primary uppercase tracking-wider">Moderator</span>
                                }@if (p.IsObserver) { <span class="text-[10px] text-gray-500 uppercase">Observer</span> }
                            </div>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full @(p.IsConnected ? "bg-success" : "bg-gray-300") shadow-sm"></span>
                    </div>
                }
            </div>
            
            <!-- Vote Stats (Only when revealed) -->
            @if (session?.IsActive == false && session.EndedAt.HasValue)
            {
                <div class="p-4 bg-gray-50 border-t border-gray-200">
                    <h4 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-3">Vote Distribution</h4>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var dist in GetVoteDistribution())
                        {
                            <div class="flex flex-col items-center bg-white border border-gray-200 rounded p-2 min-w-[3rem] shadow-sm">
                                <span class="text-lg font-bold text-gray-900">@dist.Key</span>
                                <span class="text-xs font-medium text-gray-500">@dist.Value @(dist.Value == 1 ? "vote" : "votes")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </aside>
        <!-- END: RightPanel -->
        
    </main>
    <!-- END: GameRoomArea -->

    <!-- BEGIN: CardSelectionFooter -->
    @if (!isObserver && session?.IsActive == true)
    {
        <footer class="bg-white border-t border-gray-200 p-4 md:p-6 shadow-[0_-10px_30px_rgba(0,0,0,0.05)] z-30 relative">
            <div class="max-w-6xl mx-auto flex flex-col items-center">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Choose your card</p>
                <div class="flex space-x-3 overflow-x-auto pb-4 w-full justify-center scroll-smooth px-4">
                    @foreach (var val in VoteValues.UpdateAll)
                    {
                         var isSelected = myVote == val;
                        <button class="perspective-card w-14 h-20 md:w-16 md:h-24 flex-shrink-0 rounded-lg flex items-center justify-center text-xl md:text-2xl font-bold shadow-sm transition-all duration-200
                                @(isSelected 
                                    ? "bg-primary border-2 border-primary text-white ring-4 ring-primary/20 -translate-y-4 shadow-xl scale-110" 
                                    : "bg-white border-2 border-gray-200 text-primary hover:border-primary hover:text-white hover:bg-primary hover:shadow-lg")"
                                @onclick="() => CastVote(val)">
                            @val
                        </button>
                    }
                </div>
            </div>
        </footer>
    }
    <!-- END: CardSelectionFooter -->
}

@if (showRenameModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl p-6 w-full max-w-sm animate-fade-in relative z-[60]">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Change Name</h3>
            <input type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all mb-4" 
                   @bind="renameValue" @bind:event="oninput" 
                   placeholder="Enter new name" 
                   @onkeydown="@(e => e.Key == "Enter" ? SubmitRename() : Task.CompletedTask)" />
            
            <div class="flex justify-end gap-2">
                <button class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg text-sm font-medium transition-colors" @onclick="CloseRenameModal">Cancel</button>
                <button class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-bold hover:bg-blue-700 transition-colors" @onclick="SubmitRename">Save</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid TableId { get; set; }

    private bool needsToJoin;
    private bool isLoading = true;
    private JoinTableRequest joinModel = new();
    private bool isBusy;
    private string? errorMessage;

    private TableDto? table;
    private SessionDto? session;
    private ParticipantDto? me;
    private bool isModerator;
    private bool isObserver;
    private string? myVote;
    private string newTopic = "";
    
    // Countdown State
    private bool isCountingDown;
    private int countdownValue;
    private string countdownLabel = "";
    
    private string InviteLink => Navigation.Uri;

    protected override async Task OnInitializedAsync()
    {
        // Check if we need to join
        if (PokerService.CurrentTableId != TableId || PokerService.ParticipantToken == null)
        {
            needsToJoin = true;
            isLoading = false;
        }
        else
        {
            await LoadTable();
        }
    }

    private async Task HandleJoin()
    {
        isBusy = true;
        errorMessage = null;
        try 
        {
            await PokerService.JoinTable(TableId, joinModel);
            needsToJoin = false;
            isLoading = true;
            await LoadTable();
        }
        catch (Exception ex)
        {
            errorMessage = $"Join failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadTable()
    {
        try 
        {
            table = await PokerService.GetTable(TableId);
            if (table == null) 
            {
               // Show not found UI
            }
            else 
            {
                session = table.CurrentSession;
                me = table.Participants.FirstOrDefault(p => p.Id == PokerService.CurrentParticipantId);
                isModerator = PokerService.IsModerator; // Use service state as source of truth for actions
                isObserver = me?.IsObserver ?? true;
                
                if (session?.IsActive == true)
                {
                     // Try to restore vote selection if visible? 
                }

                // Connect SignalR
                var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "https://localhost:5001/";
                var hubUrl = new Uri(new Uri(apiBaseUrl), "pokerhub").ToString();

                await RealTime.Connect(hubUrl, TableId, me?.Id ?? Guid.Empty);

                RealTime.OnUserJoined += async (id, name) => 
                {
                    await InvokeAsync(() => 
                    {
                        // Check duplicate
                        if (!table.Participants.Any(p => p.Id == id)) {
                            table.Participants.Add(new ParticipantDto { Id = id, DisplayName = name, IsConnected = true });
                            StateHasChanged();
                        }
                    });
                };
                
                RealTime.OnUserUpdated += async (id, name) => 
                {
                    await InvokeAsync(() => 
                    {
                        var p = table.Participants.FirstOrDefault(x => x.Id == id);
                        if (p != null) 
                        {
                            p.DisplayName = name;
                            if (p.Id == me?.Id) me.DisplayName = name; // Update local 'me' ref too
                            StateHasChanged();
                        }
                    });
                };
                
                RealTime.OnUserVoted += async (id) =>
                {
                    await InvokeAsync(() =>
                    {
                        var p = table.Participants.FirstOrDefault(x => x.Id == id);
                        if (p != null) p.HasVoted = true;
                        StateHasChanged();
                    });
                };
                
                RealTime.OnSessionStarted += async (s) =>
                {
                    await InvokeAsync(async () =>
                    {
                        await RunCountdown("Voting starting...", () => 
                        {
                            session = s;
                            myVote = null;
                            foreach(var p in table.Participants) p.HasVoted = false;
                        });
                    });
                };
                
                RealTime.OnSessionEnded += async (s) =>
                {
                    await InvokeAsync(async () =>
                    {
                        await RunCountdown("Revealing votes...", () => 
                        {
                            session = s;
                            // Ensure myVote is visible if I was not the one triggering the end
                        });
                    });
                };
                
                 RealTime.OnUserConnected += async (id) =>
                {
                    await InvokeAsync(() =>
                    {
                        var p = table.Participants.FirstOrDefault(x => x.Id == id);
                        if (p != null) p.IsConnected = true;
                        StateHasChanged();
                    });
                };

                RealTime.OnUserDisconnected += async (id) =>
                {
                    await InvokeAsync(() =>
                    {
                        var p = table.Participants.FirstOrDefault(x => x.Id == id);
                        if (p != null) p.IsConnected = false;
                        StateHasChanged();
                    });
                };

                RealTime.OnUserLeft += async (id) =>
                {
                    await InvokeAsync(() =>
                    {
                        var p = table.Participants.FirstOrDefault(x => x.Id == id);
                        if (p != null) 
                        {
                            table.Participants.Remove(p);
                            // If I am the one removed (shouldn't happen via this event usually if connection closed, but logic stands)
                            if (p.Id == me?.Id)
                            {
                                Navigation.NavigateTo("/");
                            }
                        }
                        StateHasChanged();
                    });
                };

                RealTime.OnModeratorChanged += async (id, name) =>
                {
                    await InvokeAsync(() =>
                    {
                        // Reset old moderators
                        foreach (var p in table.Participants) p.IsModerator = false;
                        
                        // Set new
                        var newMod = table.Participants.FirstOrDefault(x => x.Id == id);
                        if (newMod != null) newMod.IsModerator = true;
                        
                        // Check if I am the new moderator and update local state
                        if (me?.Id == id)
                        {
                            isModerator = true;
                            // Set ModeratorToken to my ParticipantToken for API calls
                            // The API ValidateModerator checks if the participant associated with the token is a moderator
                            PokerService.SetTokens(PokerService.ParticipantToken!, PokerService.ParticipantToken, TableId, me.Id); 
                        }
                        else
                        {
                            isModerator = false;
                        }
                        
                        StateHasChanged();
                    });
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            // table remains null, showing error UI
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunCountdown(string label, Action onComplete)
    {
        isCountingDown = true;
        countdownLabel = label;
        countdownValue = 3;
        StateHasChanged();

        while (countdownValue > 0)
        {
            await Task.Delay(1000);
            countdownValue--;
            StateHasChanged();
        }

        isCountingDown = false;
        onComplete?.Invoke();
        StateHasChanged();
    }

    private async Task StartSession()
    {
        await PokerService.StartSession(TableId, newTopic);
        newTopic = "";
    }
    
    private async Task StartNewSession()
    {
        await StartSession();
    }

    private async Task EndSession()
    {
        await PokerService.EndSession(TableId);
    }
    
    private async Task CastVote(string value)
    {
        myVote = value; // Optimistic update
        await PokerService.Vote(TableId, value);
    }
    
    private bool linkCopied;

    private async Task CopyLink()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", InviteLink);
        linkCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        linkCopied = false;
        StateHasChanged();
    }
    
    private string GetParticipantName(Guid id)
    {
        return table?.Participants.FirstOrDefault(p => p.Id == id)?.DisplayName ?? "Unknown";
    }

    private string GetAverageVote()
    {
        if (session == null || !session.Votes.Any()) return "-";

        var numericVotes = session.Votes
            .Select(v => v.Value)
            .Where(v => double.TryParse(v, out _))
            .Select(double.Parse)
            .ToList();

        if (!numericVotes.Any()) return "-";

        return Math.Round(numericVotes.Average(), 1).ToString("0.#");
    }

    private Dictionary<string, int> GetVoteDistribution()
    {
        if (session == null) return new Dictionary<string, int>();

        var dict = session.Votes
            .GroupBy(v => v.Value ?? "?")
            .ToDictionary(g => g.Key, g => g.Count());

        // Sort by the order defined in VoteValues if possible
        return dict.OrderBy(x => Array.IndexOf(VoteValues.UpdateAll, x.Key))
                   .ThenBy(x => x.Key)
                   .ToDictionary(x => x.Key, x => x.Value);
    }

    public async ValueTask DisposeAsync()
    {
